# Copia este archivo a .env y completa los valores.
# Nunca commits el archivo .env ni claves reales.

# Proveedor LLM: gemini | openai | anthropic
LLM_PROVIDER=gemini

# Modelo a usar (ej. gemini-2.0-flash, gpt-4o-mini, claude-3-5-sonnet-latest)
LLM_MODEL=gemini-3.1-flash-lite

# Google Gemini (requerida si LLM_PROVIDER=gemini)
GOOGLE_API_KEY=

# OpenAI (requerida si LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Anthropic (requerida si LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Ruta del checkpointer SQLite (persistencia de sesiones / thread_id)
SQLITE_DB_PATH=./data/checkpoints.db

# Límite de recursión del grafo (evita bucles infinitos y costos inesperados)
RECURSION_LIMIT=10
